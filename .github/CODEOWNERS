# Code owners for Decionis CDI.
#
# GitHub requests review from the owners listed here when a pull request touches
# a matching path. Paired with branch protection ("Require review from Code
# Owners"), this is what stops a change to the trust boundary merging on a
# drive-by approval.
#
# Ordering matters: the LAST matching pattern wins, so the specific security
# paths are listed after the general default.

# Default owner for anything not matched below.
*                           @decionis/cdi-maintainers

# --- Trust boundary. These files decide who may do what. ---------------------

# Session gating for every request: live-mode enforcement, the health-probe
# exemption, and 401-vs-redirect behaviour.
/middleware.ts              @decionis/cdi-security @decionis/cdi-maintainers

# Session construction and role parsing, including the VIEWER privilege floor.
/infra/auth/                @decionis/cdi-security @decionis/cdi-maintainers

# Credential handling, the upstream gateway, and error mapping — the code that
# decides what leaves this tier and what detail reaches a caller.
/infra/api/                 @decionis/cdi-security @decionis/cdi-maintainers

# Runtime configuration: the demo/live switch, which is what keeps the
# privileged demo session out of production.
/infra/config/              @decionis/cdi-security @decionis/cdi-maintainers

# Typed contracts. A loosened schema silently widens what this app will accept
# from upstream.
/domain/                    @decionis/cdi-security @decionis/cdi-maintainers

# Permission checks live here, not in the UI.
/application/               @decionis/cdi-security @decionis/cdi-maintainers

# --- Supply chain and published policy ---------------------------------------

# Dependency changes, the license policy gate, and CI. A change here can
# disable the checks that protect everything above.
/package.json               @decionis/cdi-security @decionis/cdi-maintainers
/pnpm-lock.yaml             @decionis/cdi-security @decionis/cdi-maintainers
/scripts/                   @decionis/cdi-security @decionis/cdi-maintainers
/.github/workflows/         @decionis/cdi-security @decionis/cdi-maintainers
/.github/CODEOWNERS         @decionis/cdi-security @decionis/cdi-maintainers

# Documents we publish as commitments to customers and reporters.
/LICENSE                    @decionis/cdi-maintainers
/NOTICE                     @decionis/cdi-maintainers
/SECURITY.md                @decionis/cdi-security @decionis/cdi-maintainers
/ThreatModel.md             @decionis/cdi-security @decionis/cdi-maintainers
/ThirdPartyLicenses.md      @decionis/cdi-security @decionis/cdi-maintainers
