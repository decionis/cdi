{
  "name": "@decionis/cdi",
  "version": "0.1.0",
  "private": true,
  "description": "Governed customer expansion for regulated fintech operations. The operational control center for Adaptive Customer Decision Intelligence.",
  "license": "Apache-2.0",
  "author": "Decionis, Inc. (https://decionis.com)",
  "homepage": "https://github.com/decionis/cdi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decionis/cdi.git"
  },
  "bugs": {
    "url": "https://github.com/decionis/cdi/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "licenses:check": "node scripts/CheckLicensePolicy.mjs",
    "licenses:list": "pnpm licenses list --prod",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "screenshots": "node scripts/CaptureScreenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.9.0",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.3",
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "js-yaml": "^4.3.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9"
    }
  }
}
